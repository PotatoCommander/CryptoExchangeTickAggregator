{
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=5432;Database=ticks;Username=ticks;Password=ticks;Pooling=true;Maximum Pool Size=10"
  },
  "Connectors": {
    "NoDataTimeoutSeconds": 30,
    "Bybit":   { "Uri":     "wss://stream.bybit.com/v5/public/spot" },
    "Binance": { "BaseUri": "wss://stream.binance.com:9443/stream" }
  },
  "Symbols": {
    "Bybit":   ["BTCUSDT", "ETHUSDT", "SOLUSDT"],
    "Binance": ["btcusdt", "ethusdt", "solusdt"]
  },
  "Batch": {
    "MaxSize": 500,
    "FlushIntervalMs": 200
  },
  "Dedup": {
    "WindowSize": 50000
  },
  "MonitoringIntervalSeconds": 5
}
